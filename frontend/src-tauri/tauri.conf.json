{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VantaVault",
  "version": "0.5.21",
  "identifier": "com.akawazak.valovault",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/dev.js",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VantaVault",
        "width": 1664,
        "height": 936,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:31719 https://valorant-api.com https://api.github.com",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://media.valorant-api.com",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/valovault-backend"
    ],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "VantaVault",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MEM3MzBGRDhFM0E1QwpSV1JjT283OU1NZGdBb1NFNEFES2MvU1dVY3E2UFlrTmhCTmlLM3hLV0xIaVlSL0tzSjBUMzVqQwo=",
      "endpoints": [
        "https://github.com/akawazak/valo-project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
