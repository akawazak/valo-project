{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VantaVault",
  "version": "0.5.11",
  "identifier": "com.akawazak.valovault",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/dev.js",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VantaVault",
        "width": 1664,
        "height": 936,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/valovault-backend"
    ],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MEM3MzBGRDhFM0E1QwpSV1JjT283OU1NZGdBb1NFNEFES2MvU1dVY3E2UFlrTmhCTmlLM3hLV0xIaVlSL0tzSjBUMzVqQwo=",
      "endpoints": [
        "https://github.com/akawazak/valo-project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
