{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/valorant-store-checker", "destination": "/#features", "permanent": false },
    { "source": "/valorant-loadout-manager", "destination": "/#features", "permanent": false },
    { "source": "/valorant-match-history", "destination": "/#features", "permanent": false },
    { "source": "/valorant-live-match", "destination": "/#features", "permanent": false },
    { "source": "/privacy-and-security", "destination": "/#download", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
